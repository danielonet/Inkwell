resource app_signature "application/x-vnd.Inkwell";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "Inkwell",
	long_info = "Inkwell - a text editor for Markdown, RTF and plain text."
};

